# Neon Postgres connection string (Dashboard -> your project -> Connection Details).
# Keep sslmode=require in the URL.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/bookshelf?sslmode=require

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Origin of the deployed frontend (GitHub Pages), used for CORS + cookies.
# Example: https://yourusername.github.io
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" when deployed (enables secure, cross-site cookies).
NODE_ENV=development

PORT=3001
