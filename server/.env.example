# Neon Postgres connection string (Dashboard -> your project -> Connection Details).
# Keep sslmode=require in the URL.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/bookshelf?sslmode=require

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Origin of the deployed frontend (GitHub Pages), used for CORS + cookies.
# Example: https://yourusername.github.io
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" when deployed (enables secure, cross-site cookies).
NODE_ENV=development

PORT=3001

# Keeps the instance warm on hosts that sleep idle services (Render's free
# tier sleeps after ~15 minutes). The server requests its own public URL on
# an interval, which counts as inbound traffic and resets that idle timer.
# On Render, RENDER_EXTERNAL_URL is injected automatically and nothing needs
# setting here. Active in production only, unless SELF_PING=on.
#   SELF_PING=on|off              force it on (any env) or off entirely
#   SELF_PING_URL=https://...     public origin, if not on Render
#   SELF_PING_INTERVAL_MS=600000  default 10 min; clamped to 1-14 min
